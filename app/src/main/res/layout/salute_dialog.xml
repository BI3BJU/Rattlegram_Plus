<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salute_size"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/salute_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salute_size_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/salute_activity"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/salute_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salute_activity_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/salute_location"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/salute_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salute_location_hint"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/salute_location_format"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:entries="@array/salute_location_formats" />

            <Button
                android:id="@+id/salute_gps_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salute_from_gps"
                style="?android:attr/borderlessButtonStyle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/salute_unit"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/salute_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salute_unit_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/salute_time"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/salute_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salute_time_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioGroup
                android:id="@+id/salute_time_zone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/salute_time_utc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/salute_utc" />

                <RadioButton
                    android:id="@+id/salute_time_local"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/salute_local" />
            </RadioGroup>

            <Button
                android:id="@+id/salute_now_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salute_now"
                style="?android:attr/borderlessButtonStyle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/salute_equipment"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/salute_equipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salute_equipment_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            android:id="@+id/salute_bytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
