<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Block 1: Voice beacon -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_section_voice"
        android:textStyle="bold"
        android:paddingTop="4dp" />

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/beacon_interval_min" />

        <EditText
            android:id="@+id/beacon_interval_edit"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:gravity="center"
            android:text="1"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_interval_range"
        android:textSize="11sp"
        android:paddingBottom="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#888888"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Block 2: Network beacon sending -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_section_net_send"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/net_send_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_net_send_enabled" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/beacon_send_type" />

        <RadioGroup
            android:id="@+id/net_send_type_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/net_type_direct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/beacon_type_direct" />

            <RadioButton
                android:id="@+id/net_type_relay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/beacon_type_relay" />
        </RadioGroup>
    </LinearLayout>

    <!-- Direct-mode params: single-line rows (label + edit) to save height -->
    <LinearLayout
        android:id="@+id/direct_params"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/beacon_freq"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/direct_freq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/beacon_freq"
                android:textSize="14sp"
                android:inputType="numberDecimal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/beacon_freq_range"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/beacon_tone"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/direct_tone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/beacon_tone"
                android:textSize="14sp"
                android:inputType="numberDecimal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/beacon_tone_range"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Relay-mode params: single-line rows (label + edit) to save height.
         This block no longer pushes the receive section off-screen. -->
    <LinearLayout
        android:id="@+id/relay_params"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/beacon_up_freq"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/relay_up_freq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/beacon_up_freq"
                android:textSize="14sp"
                android:inputType="numberDecimal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/beacon_freq_range"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/beacon_down_freq"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/relay_down_freq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/beacon_down_freq"
                android:textSize="14sp"
                android:inputType="numberDecimal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/beacon_freq_range"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/beacon_tone"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/relay_tone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/beacon_tone"
                android:textSize="14sp"
                android:inputType="numberDecimal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/beacon_tone_range"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_position"
        android:paddingTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/beacon_lat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/beacon_lat"
            android:textSize="14sp"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/beacon_lon"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/beacon_lon"
            android:textSize="14sp"
            android:inputType="numberDecimal|numberSigned" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#888888"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Block 3: Network beacon receiving -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_section_net_recv"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/net_recv_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_net_recv_enabled" />

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/beacon_recv_radius_km" />

        <EditText
            android:id="@+id/beacon_recv_radius_edit"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:gravity="center"
            android:text="10"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_radius_range"
        android:textSize="11sp"
        android:paddingBottom="2dp" />

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/beacon_recv_window_min" />

        <EditText
            android:id="@+id/beacon_recv_window_edit"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:gravity="center"
            android:text="10"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_window_range"
        android:textSize="11sp"
        android:paddingBottom="2dp" />
</LinearLayout>