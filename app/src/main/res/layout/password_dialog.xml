<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:minHeight="200dp">

    <EditText
        android:id="@+id/password_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/password"
        android:inputType="textVisiblePassword"
        android:maxLines="1"
        android:singleLine="true"
        android:selectAllOnFocus="true" />

    <TextView
        android:id="@+id/password_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/password_length_hint"
        android:textSize="12sp"
        android:textColor="@color/tint"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/password_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <!-- Bottom button row: uses RelativeLayout for left-center-right layout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <!-- Cancel button: left aligned -->
        <Button
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_alignParentStart="true"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Generate random password button: centered -->
        <Button
            android:id="@+id/generate_password_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generate_random_password"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:maxLines="1"
            style="?android:attr/borderlessButtonStyle" />

        <!-- OK button: right aligned -->
        <Button
            android:id="@+id/button_okay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/okay"
            android:layout_alignParentEnd="true"
            style="?android:attr/borderlessButtonStyle" />
    </RelativeLayout>
</LinearLayout>